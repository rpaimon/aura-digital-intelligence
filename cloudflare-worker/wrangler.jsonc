{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aura-intelligence-automation",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "MAX_STORIES_PER_RUN": "6",
    "MAX_RESEARCH_PER_RUN": "2",
    "AI_MODEL": "@cf/zai-org/glm-4.7-flash"
  }
}
